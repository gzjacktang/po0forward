[Unit]
Description=Node rule service
Wants=network-online.target
After=network-online.target nftables.service

[Service]
User=root
ExecStart=/usr/local/bin/po0forward-agent --config /etc/po0forward/agent.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/po0forward
UMask=0077

[Install]
WantedBy=multi-user.target
